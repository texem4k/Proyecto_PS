import androidx.compose.ui.graphics.Color;
import kotlin.Boolean;
import kotlin.String;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;
import software.ulpgc.code.architecture.model.Priority;
import software.ulpgc.code.architecture.model.Privilege;
import software.ulpgc.code.architecture.model.tasks.TaskInterval;
import software.ulpgc.code.architecture.model.times.Time;

--  ./gradlew generateCommonMainAppDatabaseInterface
PRAGMA foreign_keys = 1;

-- TABLAS DE USUARIOS
CREATE TABLE User (
    id TEXT AS Uuid PRIMARY KEY,
    name TEXT AS String NOT NULL
);

CREATE TABLE WorkGroup (
    id TEXT AS Uuid PRIMARY KEY,
    name TEXT AS String NOT NULL,
    description TEXT AS String NOT NULL
);

CREATE TABLE WorkGroupUser (
    userId TEXT AS Uuid NOT NULL,
    groupId TEXT AS Uuid NOT NULL,
    privilege INTEGER AS Privilege NOT NULL,
    PRIMARY KEY(userId, groupId),
    FOREIGN KEY (userId) REFERENCES User(id) ON DELETE CASCADE,
    FOREIGN KEY (groupId) REFERENCES WorkGroup(id) ON DELETE CASCADE
);

CREATE TABLE AssignUserTask (
    taskId TEXT AS Uuid NOT NULL,
    userId TEXT AS Uuid NOT NULL,
    groupId TEXT AS Uuid NOT NULL,
    PRIMARY KEY (taskId, userId),
    FOREIGN KEY (taskId, groupId) REFERENCES Task(id, groupId) ON DELETE CASCADE,
    FOREIGN KEY (userId, groupId) REFERENCES WorkGroupUser(userId, groupId) ON DELETE CASCADE
);

-- TABLAS DE DATOS
CREATE TABLE Topic (
    id TEXT AS Uuid PRIMARY KEY,
    groupId TEXT AS Uuid NOT NULL,
    name TEXT AS String NOT NULL,
    color INTEGER AS Color NOT NULL,
    FOREIGN KEY (groupId) REFERENCES WorkGroup(id) ON DELETE CASCADE,
    UNIQUE (id, groupId)
);

CREATE TABLE Tag (
    id TEXT AS Uuid PRIMARY KEY,
    topicId TEXT AS Uuid NOT NULL,
    name TEXT AS String NOT NULL,
    FOREIGN KEY (topicId) REFERENCES Topic(id) ON DELETE CASCADE,
    UNIQUE (id, topicId)
);

CREATE TABLE Task (
    id TEXT AS Uuid PRIMARY KEY,
    topicId TEXT AS Uuid NOT NULL,
    groupId TEXT AS Uuid NOT NULL,
    name TEXT AS String NOT NULL,
    description TEXT AS String NOT NULL,
    time TEXT AS Time NOT NULL,
    interval INTEGER AS TaskInterval NOT NULL,
    priority INTEGER AS Priority NOT NULL,
    isCompleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (topicId, groupId) REFERENCES Topic(id, groupId) ON DELETE CASCADE,
    UNIQUE (id, groupId),
    UNIQUE (id, topicId)
);

CREATE TABLE TaskTag (
    taskId TEXT AS Uuid NOT NULL,
    tagId TEXT AS Uuid NOT NULL,
    topicId TEXT AS Uuid NOT NULL,
    PRIMARY KEY (taskId, tagId),
    FOREIGN KEY (taskId, topicId) REFERENCES Task(id, topicId) ON DELETE CASCADE,
    FOREIGN KEY (tagId, topicId) REFERENCES Tag(id, topicId) ON DELETE CASCADE
);

-- TABLAS DE METADATOS
CREATE TABLE TaskCompletion (
    id TEXT AS Uuid PRIMARY KEY,
    taskId TEXT AS Uuid NOT NULL,
    date TEXT AS Instant NOT NULL,
    completed INTEGER AS Boolean NOT NULL,
    FOREIGN KEY (taskId) REFERENCES Task(id) ON DELETE CASCADE
);

-- Inserciones
insertUser:
INSERT OR IGNORE INTO User VALUES (id = ?, name = ?);

insertGroup:
INSERT OR IGNORE INTO WorkGroup VALUES (id = ?, name = ?, description = ?);

insertUserIntoGroup:
INSERT OR IGNORE INTO WorkGroupUser VALUES (userId = ?, groupId = ?, privilege = ?);

insertUserForTask:
INSERT OR IGNORE INTO AssignUserTask(taskId, userId, groupId)
    SELECT :taskId, :userId, Task.groupId
    FROM Task
    WHERE Task.id = :taskId;

insertTopic:
INSERT OR IGNORE INTO Topic VALUES (id = ?, groupId = ?, name = ?, color = ?);

insertTag:
INSERT OR IGNORE INTO Tag VALUES (id = ?, topicId = ?, name = ?);

insertTask:
INSERT OR IGNORE INTO Task(id, topicId, groupId, name, description, time, interval, priority, isCompleted)
    SELECT :id, :topicId, Topic.groupId, :name, :description, :time, :interval, :priority, :isCompleted
    FROM Topic
    WHERE Topic.id = :topicId;

insertTagForTask:
INSERT OR IGNORE INTO TaskTag(taskId, tagId, topicId)
    SELECT :taskId, :tagId, Task.topicId
    FROM Task
    WHERE Task.id = :taskId;

insertTaskCompletion:
INSERT OR IGNORE INTO TaskCompletion VALUES (id = ?, taskId = ?, date = ?, completed = ?);

-- Actualizaciones
updateUser:
UPDATE User SET name = ? WHERE id = ?;

updateGroup:
UPDATE WorkGroup SET name = ?, description = ? WHERE id = ?;

updateTopic:
UPDATE Topic SET name = ?, color = ? WHERE id = ?;

updateTag:
UPDATE Tag SET name = ? WHERE id = ?;

updateTask:
UPDATE Task SET name = ?, description = ?, time = ?, interval = ?, priority = ?, isCompleted = ? WHERE id = ?;

updateTaskCompletion:
UPDATE TaskCompletion SET date = ?, completed = ? WHERE id = ?;

-- Borraciones
deleteUser:
DELETE FROM User WHERE id = ?;

deleteGroup:
DELETE FROM WorkGroup WHERE id = ?;

deleteUsersFromGroup:
DELETE FROM WorkGroupUser WHERE groupId = ?;

deleteTopic:
DELETE FROM Topic WHERE id = ?;

deleteTag:
DELETE FROM Tag WHERE id = ?;

deleteTask:
DELETE FROM Task WHERE id = ?;

deleteTagsForTask:
DELETE FROM TaskTag WHERE taskId = ?;

deleteUsersForTask:
DELETE FROM AssignUserTask WHERE taskId = ?;

deleteTaskCompletion:
DELETE FROM TaskCompletion WHERE id = ?;

-- Seleciones
getUsers:
SELECT * FROM User;

getGroups:
SELECT * FROM WorkGroup;

getUsersInGroups:
SELECT * FROM WorkGroupUser;

getUsersFor:
SELECT * FROM AssignUserTask WHERE taskId = ?;

getTopics:
SELECT * FROM Topic;

getTags:
SELECT * FROM Tag;

getTasks:
SELECT * FROM Task;

getTagsFor:
SELECT * FROM TaskTag WHERE taskId = ?;

getTaskCompletions:
SELECT * FROM TaskCompletion;